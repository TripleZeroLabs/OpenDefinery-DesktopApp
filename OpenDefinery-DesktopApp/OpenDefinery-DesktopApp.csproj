<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK-style WPF project (converted from the classic packages.config format).
    Rationale: the modern SDK's WPF markup compilation doesn't emit and load an
    unsigned temporary .exe the way the classic build did, which is what Smart App
    Control was blocking (MC2000). Kept on net472 to avoid touching the
    MaterialDesign/MahApps dependency versions.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>OpenDefinery_DesktopApp</RootNamespace>
    <AssemblyName>OpenDefinery-DesktopApp</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- Keep the existing Properties\AssemblyInfo.cs (don't let the SDK generate a
         second set of assembly attributes). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Framework assemblies the SDK doesn't reference implicitly for net4x.
         (System.Web dropped: the API client no longer uses it, keeping it netstandard-ready.) -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Data" />
  </ItemGroup>

  <ItemGroup>
    <!-- MahApps.Metro.IconPacks.Core comes in transitively via BoxIcons. -->
    <PackageReference Include="MahApps.Metro.IconPacks.BoxIcons" Version="4.6.0" />
    <PackageReference Include="MaterialDesignColors" Version="1.2.7" />
    <PackageReference Include="MaterialDesignThemes" Version="3.2.0" />
    <!-- JSON for the OpenDefinery API client (OdHttp/OdJson). Replaces RestSharp + Newtonsoft.
         On net472 this is a NuGet package; when this client moves to the shared netstandard2.0
         library it stays the same, and System.Text.Json is in-box on the net8/net10 Revit runtimes. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF image resources are not auto-included; App.xaml (ApplicationDefinition)
         and *.xaml (Page) are. -->
    <Resource Include="favicon.ico" />
    <Resource Include="OpenDefinery-Logo_BlueGrayBG_512x512.png" />
    <EmbeddedResource Include="assets\OpenDefinery-Logo_BlueGrayBG_512x512.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

</Project>
